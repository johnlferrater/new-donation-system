{
    "tabWidth": 4,
    "useTabs": false,
    "printWidth": 100,
    "singleQuote": true,
    "semi": true,
    "trailingComma": "es5",
    "endOfLine": "lf",
    "overrides": [
        {
            "files": "src/main/resources/templates/**/*.html",
            "options": {
                "htmlWhitespaceSensitivity": "ignore",
                "printWidth": 120
            }
        }
    ]
}
