# Copy these names into Railway/Netlify environment variables.
# Do not commit real values. See DEPLOYMENT.md.

# Railway-provided; do not set this by hand except for local testing.
PORT=8080

# MySQL on Railway. SPRING_DATASOURCE_URL must be a JDBC URL.
SPRING_DATASOURCE_URL=jdbc:mysql://MYSQLHOST:3306/donation_system
SPRING_DATASOURCE_USERNAME=
DB_PASSWORD=

# CORS: exact Netlify frontend origin(s), comma-separated.
CORS_ALLOWED_ORIGINS=https://your-site.netlify.app

# Session/CSRF cookie behavior for the chosen deployment mode.
# Recommended proxy mode: SESSION_COOKIE_SECURE=true, SESSION_COOKIE_SAME_SITE=Lax, CSRF_COOKIE_SAME_SITE=Lax
# Split SPA/CORS mode: SESSION_COOKIE_SECURE=true, SESSION_COOKIE_SAME_SITE=None, CSRF_COOKIE_SAME_SITE=None
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=Lax
CSRF_COOKIE_SAME_SITE=Lax

# Optional first admin on an empty database. Remove these after the admin is created.
APP_BOOTSTRAP_ADMIN_USERNAME=
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
ADMIN_SIGNUP_CODE=
